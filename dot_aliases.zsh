# Migrated from atuin dotfiles (deprecated). See:
# https://docs.atuin.sh/ -> dotfiles/aliases is legacy and no longer synced.
alias at='atuin'
alias atsr='atuin scripts run'
alias chezmoi-backup='chezmoi managed -0 | xargs -0 tar czf chezmoi-backup-$(date -Iseconds).tar.gz'
alias claude-code='claude'
