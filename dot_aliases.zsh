alias ll='ls -lah'
alias ls='ls --color=auto'
alias mvv='mv -v'
alias powershell='pwsh'
alias t='task'
alias tf='terraform'
alias tg='terragrunt'
alias tga='tg apply'
alias tgd='tg destroy'
alias tgp='tg plan'
alias tgr='tg refresh'
