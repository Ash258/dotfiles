#!/usr/bin/env bash
#MISE description="Decrypt a .secrets/*.age file into $EDITOR and re-encrypt it on save"
#USAGE arg "<file>" help="Secret to edit or create, e.g. seed-mcp-keychain.sh (.secrets/ and .age are optional)"
#USAGE flag "--view" help="Print the decrypted secret instead of editing it"

set -euo pipefail

# shellcheck disable=SC2154 # usage_file is set by mise from the #USAGE line
name="${usage_file#.secrets/}"
name="${name%.age}"
secret=".secrets/$name.age"

if [[ "${usage_view:-false}" == true ]]; then
    [[ -f "$secret" ]] || { echo "No such secret $secret" >&2; exit 1; }
    chezmoi decrypt "$secret"
    exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
# Keep the real name so the editor picks the right syntax
plain="$tmp/$name"

if [[ -f "$secret" ]]; then
    chezmoi decrypt "$secret" > "$plain"
else
    echo "Creating new secret $secret"
    : > "$plain"
fi
cp "$plain" "$tmp/.original"

# Word-split on purpose, so editors with flags (code --wait) work
read -ra editor <<< "${VISUAL:-${EDITOR:-vi}}"
"${editor[@]}" "$plain"

if cmp -s "$plain" "$tmp/.original"; then
    echo "No changes, $secret left untouched"
    exit 0
fi

chezmoi encrypt "$plain" > "$secret.tmp"
mv "$secret.tmp" "$secret"
echo "Encrypted $secret"
